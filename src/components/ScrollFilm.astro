---
/**
 * Full-page light film scroll (Janustiu): scroll = timeline.
 * HN paper aesthetic. Scenes hand off as overlays; chart is a fixed-aspect SVG.
 */
import {
  whatIs,
  jump,
  applyRoutes,
  apply,
  filmScroll,
} from '../content/site';

const X0 = 140;
const X12 = 760;
const Y0 = 268;
const ticks = jump.chart.axis.map((label, i) => ({
  label,
  x: X0 + ((X12 - X0) / (jump.chart.axis.length - 1)) * i,
}));

const btnClass = (tone: 'purple' | 'blue' | 'white') =>
  tone === 'purple' ? 'btn-purple' : tone === 'blue' ? 'btn-blue' : 'btn-white';

// Overlapping ranges = soft crossfades between scenes
const scenes = [
  { id: 'hero', in: 0.0, out: 0.18 },
  { id: 'offer', in: 0.14, out: 0.34 },
  { id: 'path', in: 0.3, out: 0.5 },
  { id: 'arc', in: 0.46, out: 0.66 },
  { id: 'routes', in: 0.62, out: 0.82 },
  { id: 'apply', in: 0.78, out: 1.0 },
] as const;
---

<section
  id="film"
  class="film"
  data-film
  data-mode={filmScroll.mode}
  data-frame-count={filmScroll.frameCount}
  data-frame-pad={filmScroll.framePad}
  data-frame-path={filmScroll.framePath}
  data-frame-ext={filmScroll.frameExt}
  data-key-count={filmScroll.keyCount}
  data-key-pad={filmScroll.keyPad}
  data-key-path={filmScroll.keyPath}
  data-key-ext={filmScroll.keyExt}
  style={`--film-screens: ${filmScroll.scrollScreens}`}
>
  <span id="top" class="absolute top-0" aria-hidden="true"></span>
  <div class="film__sticky">
    <canvas class="film__canvas" data-film-canvas aria-hidden="true"></canvas>
    <div class="film__veil" aria-hidden="true"></div>

    <div class="film__stage">
      <!-- 1 Hero -->
      <div class="scene" data-scene data-in={scenes[0].in} data-out={scenes[0].out} aria-hidden="true">
        <p class="marker">{whatIs.eyebrow}</p>
        <span class="mt-4 inline-flex items-center rounded-full border border-ink/10 bg-paper/85 px-3 py-1 text-[0.6875rem] font-medium tracking-[0.14em] text-ink uppercase">
          {whatIs.badge}
        </span>
        <h1 class="display mt-5 text-[clamp(2.5rem,7vw,4.75rem)]">
          <span class="text-gray">{whatIs.headline.lead}</span>
          {' '}
          <em class="italic text-ink">{whatIs.headline.emphasis}</em>
        </h1>
        <p class="hero-sub mx-auto mt-4 max-w-xl">{whatIs.sub}</p>
      </div>

      <!-- 2 Offer -->
      <div class="scene" data-scene data-in={scenes[1].in} data-out={scenes[1].out} aria-hidden="true">
        <p class="scene-title">{whatIs.pillarsLabel}</p>
        <div class="pillars mt-8">
          {
            whatIs.pillars.map((p) => (
              <div class="pillar">
                <h2>{p.title}</h2>
                <p>{p.body}</p>
              </div>
            ))
          }
        </div>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-4 opacity-70">
          {
            whatIs.partners.orgs.map((org) => (
              <a href={org.href} rel="noopener" target="_blank" aria-label={org.name}>
                <img src={org.logo} alt="" height={org.h} style={`height:${org.h}px`} class="w-auto" loading="lazy" />
              </a>
            ))
          }
        </div>
      </div>

      <!-- 3 Path -->
      <div class="scene" data-scene data-in={scenes[2].in} data-out={scenes[2].out} aria-hidden="true">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <h2 class="font-serif text-[clamp(1.75rem,4.5vw,2.75rem)] leading-none tracking-tight text-hn-blue uppercase">
            {whatIs.pathLabel}
          </h2>
          <p class="marker-blue">{whatIs.pathEnd}</p>
        </div>
        <ol class="path-rail mt-10">
          {
            whatIs.steps.map((step) => (
              <li>
                <p class="path-num">{step.num}</p>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- 4 Chart: fixed aspect SVG, light -->
      <div class="scene scene--wide" data-scene data-in={scenes[3].in} data-out={scenes[3].out} aria-hidden="true">
        <p class="marker">{jump.marker}</p>
        <p class="section-sub mx-auto max-w-md">{jump.sub}</p>
        <div class="chart-frame mt-8" role="img" aria-label={jump.chart.aria}>
          <svg viewBox="0 0 920 340" preserveAspectRatio="xMidYMid meet" width="920" height="340" aria-hidden="true">
            {ticks.map((t) => (
              <line x1={t.x} y1="36" x2={t.x} y2={Y0} stroke="#ecebea" stroke-width="1" />
            ))}
            <line x1="40" y1={Y0} x2="880" y2={Y0} stroke="#ecebea" stroke-width="1" />
            {ticks.map((t) => (
              <g>
                <line x1={t.x} y1={Y0} x2={t.x} y2={Y0 + 7} stroke="#6d6c6b" stroke-width="1" />
                <text x={t.x} y={Y0 + 26} text-anchor="middle" fill="#6d6c6b" font-family="Inter,sans-serif" font-size="11" letter-spacing="1.1">
                  {t.label}
                </text>
              </g>
            ))}

            <path d="M40 248 L78 248 L96 236 L140 232" fill="none" stroke="#6d6c6b" stroke-width="1.5" />
            <text x="42" y="224" fill="#6d6c6b" font-family="Inter,sans-serif" font-size="11" letter-spacing="1.1">
              {jump.chart.startLabel}
            </text>

            <line x1={X0} y1="232" x2="860" y2="228" stroke="#a8a7a5" stroke-width="1" stroke-dasharray="2 6" />
            <text x="860" y="218" text-anchor="end" fill="#a8a7a5" font-family="Inter,sans-serif" font-size="10" letter-spacing="1.1">
              {jump.chart.aloneLabel}
            </text>

            <path
              d={`M${X0} 232 C320 230 480 210 600 155 C680 115 730 78 ${X12} 52`}
              fill="none"
              stroke="#111111"
              stroke-width="2"
              stroke-linecap="round"
            />
            <circle cx={X0} cy="232" r="4" fill="#111111" />
            <text x={X0 + 12} y="254" fill="#272625" font-family="Inter,sans-serif" font-size="11" letter-spacing="1.1">
              {jump.chart.labStartLabel}
            </text>
            <circle cx="420" cy="205" r="4" fill="#111111" />
            <text x="420" y="188" text-anchor="middle" fill="#272625" font-family="Inter,sans-serif" font-size="11" letter-spacing="1.1">
              {jump.chart.midLabel}
            </text>
            <circle cx={X12} cy="52" r="5" fill="#328efa" />
            <text x={X12 - 12} y="42" text-anchor="end" fill="#328efa" font-family="Inter,sans-serif" font-size="11" font-weight="500" letter-spacing="1.1">
              {jump.chart.endLabel}
            </text>
            <line x1={X12} y1="52" x2="845" y2="28" stroke="#e8400d" stroke-width="1.75" stroke-dasharray="6 6" />
            <circle cx="845" cy="28" r="4" fill="none" stroke="#e8400d" stroke-width="1.75" />
            <text x="856" y="32" fill="#e8400d" font-family="Inter,sans-serif" font-size="11" letter-spacing="1.1">
              {jump.chart.branchLabel}
            </text>
          </svg>
        </div>
      </div>

      <!-- 5 Paths -->
      <div class="scene scene--wide" data-scene data-in={scenes[4].in} data-out={scenes[4].out} aria-hidden="true">
        <p class="marker">{applyRoutes.marker}</p>
        <h2 class="section-title mt-3 italic">{applyRoutes.headline}</h2>
        <div class="routes mt-8">
          {
            applyRoutes.paths.map((path) => (
              <a
                href={path.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'route',
                  path.tone === 'purple' && 'route--purple',
                  path.tone === 'blue' && 'route--blue',
                  path.tone === 'white' && 'route--white',
                ]}
              >
                <p class="route-role">{path.role}</p>
                <h3>{path.title}</h3>
                <p class="route-body">{path.body}</p>
                <span class:list={['route-cta', `route-cta--${path.tone}`]}>
                  {path.cta} →
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- 6 Apply -->
      <div id="apply" class="scene" data-scene data-in={scenes[5].in} data-out={scenes[5].out} aria-hidden="true">
        <p class="marker">{apply.marker}</p>
        <h2 class="mt-3 text-[clamp(1.4rem,3.5vw,2.1rem)] font-semibold tracking-[0.06em] uppercase">
          {apply.headline}
        </h2>
        {apply.sub && <p class="section-sub mx-auto max-w-md">{apply.sub}</p>}
        <div class="apply-btns mt-6 w-full max-w-lg">
          {
            apply.buttons.map((btn) => (
              <a
                href={btn.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[btnClass(btn.tone), 'inline-flex min-h-11 w-full items-center justify-center px-6 text-center']}
              >
                {btn.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="film__loader" data-film-loader hidden={filmScroll.mode === 'procedural'}>
      <p data-film-loader-pct>0%</p>
    </div>
  </div>
  <div class="film__spacer" aria-hidden="true"></div>
</section>

<style>
  .film {
    position: relative;
    background: #ffffff;
    color: var(--color-ink);
  }

  .film__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    height: 100dvh;
    overflow: hidden;
    isolation: isolate;
  }

  .film__spacer {
    height: calc(var(--film-screens) * 100svh);
    height: calc(var(--film-screens) * 100dvh);
    pointer-events: none;
  }

  .film__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    background: #ffffff;
  }

  .film__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, color-mix(in srgb, #fff 55%, transparent), transparent 18%, transparent 62%, color-mix(in srgb, #fff 72%, transparent)),
      radial-gradient(ellipse 70% 55% at 50% 42%, transparent 35%, color-mix(in srgb, #fff 35%, transparent) 100%);
  }

  .film__loader {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: grid;
    place-items: center;
    background: #fff;
    transition: opacity 0.4s ease;
  }

  .film__loader[hidden],
  .film__loader.is-done {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .film__loader p {
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gray);
  }

  .film__stage {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: 5.5rem 1.5rem 3rem;
  }

  .scene {
    position: absolute;
    inset: 5.5rem 1.5rem 3rem;
    margin: auto;
    width: min(56rem, 100%);
    max-height: calc(100% - 8rem);
    overflow: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    opacity: 0;
    transform: translate3d(0, 28px, 0) scale(0.975);
    transform-origin: center center;
    pointer-events: none;
    will-change: opacity, transform;
    backface-visibility: hidden;
  }

  .scene.is-on {
    pointer-events: auto;
  }

  .scene--wide {
    width: min(64rem, 100%);
  }

  .scene-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-style: italic;
    letter-spacing: -0.02em;
  }

  .pillars {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    text-align: left;
  }

  .pillar {
    padding: 1rem 1.05rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, #fff 88%, transparent);
    box-shadow: var(--shadow-soft);
  }

  .pillar h2 {
    font-size: 1rem;
    font-weight: 600;
  }

  .pillar p {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-gray);
  }

  @media (min-width: 640px) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .pillars {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .path-rail {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: left;
  }

  .path-rail li {
    padding: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, #fff 90%, transparent);
  }

  .path-num {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-hn-blue);
  }

  .path-rail h3 {
    margin-top: 0.55rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .path-rail p:last-child {
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    color: var(--color-gray);
  }

  @media (min-width: 768px) {
    .path-rail {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .chart-frame {
    width: 100%;
    max-width: 48rem;
    aspect-ratio: 920 / 340;
    margin-inline: auto;
  }

  .chart-frame svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .routes {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    text-align: left;
  }

  .route {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line);
    background: #fff;
    box-shadow: var(--shadow-soft);
    transition: transform 0.3s var(--ease-out-quart), border-color 0.2s ease;
  }

  .route--purple {
    border: 2px solid var(--color-hn-purple);
    background: var(--color-hn-purple-soft);
  }

  .route--blue {
    border-color: color-mix(in srgb, var(--color-hn-blue) 40%, var(--color-line));
    background: color-mix(in srgb, var(--color-hn-blue-soft) 80%, white);
  }

  .route--white {
    border-color: var(--color-line);
    background: #fff;
  }

  .route-role {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gray);
  }

  .route--purple .route-role {
    color: var(--color-hn-purple);
  }

  .route--blue .route-role {
    color: var(--color-hn-blue);
  }

  .route h3 {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: 1.35rem;
  }

  .route-body {
    margin-top: 0.5rem;
    flex: 1;
    font-size: 0.875rem;
    color: var(--color-gray);
  }

  .route-cta {
    margin-top: 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .route-cta--purple {
    color: var(--color-hn-purple);
  }

  .route-cta--blue {
    color: var(--color-hn-blue);
  }

  .apply-btns {
    display: grid;
    gap: 0.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .route:hover {
      transform: translateY(-4px);
    }
  }

  @media (min-width: 768px) {
    .routes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .film__spacer {
      height: 0;
    }
    .film__sticky {
      position: relative;
      height: auto;
      min-height: 100svh;
    }
    .film__canvas,
    .film__veil,
    .film__loader {
      display: none;
    }
    .film__stage {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 4rem;
      padding: 6rem 1.5rem;
    }
    .scene {
      position: relative;
      inset: auto;
      opacity: 1 !important;
      transform: none !important;
      pointer-events: auto !important;
      max-height: none;
      overflow: visible;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-film]');
  if (root) {
    const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-film-canvas]')!;
    const ctx = canvas.getContext('2d', { alpha: false })!;
    const loader = root.querySelector<HTMLElement>('[data-film-loader]');
    const loaderPct = root.querySelector<HTMLElement>('[data-film-loader-pct]');
    const scenes = [...root.querySelectorAll<HTMLElement>('[data-scene]')];
    let mode = root.dataset.mode || 'procedural';

    const keyCount = Number(root.dataset.keyCount || 7);
    const keyPad = Number(root.dataset.keyPad || 2);
    const keyPath = root.dataset.keyPath || '/film-keys/key_';
    const keyExt = root.dataset.keyExt || 'webp';

    let dpr = 1;
    let w = 0;
    let h = 0;
    let target = 0;
    let smooth = 0;
    let keys: (HTMLImageElement | null)[] = [];
    let ready = mode === 'procedural';

    const clamp01 = (n: number) => Math.max(0, Math.min(1, n));

    function easeInOutCubic(t: number) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function alpha(p: number, inn: number, out: number) {
      const fade = 0.055;
      if (p <= inn || p >= out) return 0;
      if (p < inn + fade) return easeInOutCubic((p - inn) / fade);
      if (p > out - fade) return easeInOutCubic((out - p) / fade);
      return 1;
    }

    function drawCover(img: HTMLImageElement, opacity = 1) {
      if (!img?.naturalWidth) return;
      const scale = Math.max(w / img.naturalWidth, h / img.naturalHeight);
      const dw = img.naturalWidth * scale;
      const dh = img.naturalHeight * scale;
      const dx = (w - dw) / 2;
      const dy = (h - dh) / 2;
      ctx.save();
      ctx.globalAlpha = opacity;
      ctx.drawImage(img, dx, dy, dw, dh);
      ctx.restore();
    }

    function paintProcedural(p: number) {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, w, h);
      const cx = w * 0.5;
      const drift = p * 0.35;
      const left = ctx.createRadialGradient(w * (0.12 + drift * 0.08), h * 0.18, 0, w * 0.12, h * 0.2, w * 0.55);
      left.addColorStop(0, 'rgba(208, 178, 255, 0.28)');
      left.addColorStop(1, 'rgba(208, 178, 255, 0)');
      ctx.fillStyle = left;
      ctx.fillRect(0, 0, w, h);
      const right = ctx.createRadialGradient(w * (0.88 - drift * 0.06), h * 0.22, 0, w * 0.9, h * 0.25, w * 0.55);
      right.addColorStop(0, 'rgba(153, 255, 249, 0.22)');
      right.addColorStop(1, 'rgba(153, 255, 249, 0)');
      ctx.fillStyle = right;
      ctx.fillRect(0, 0, w, h);
    }

    /** Crossfade between AI keyframes along scroll progress */
    function paintKeyframes(p: number) {
      const n = keys.filter(Boolean).length;
      if (n < 2) {
        paintProcedural(p);
        return;
      }
      const maxI = n - 1;
      const f = p * maxI;
      const i0 = Math.min(maxI - 1, Math.floor(f));
      const i1 = Math.min(maxI, i0 + 1);
      const t = easeInOutCubic(f - i0);
      ctx.fillStyle = '#0a0a0a';
      ctx.fillRect(0, 0, w, h);
      const a = keys[i0];
      const b = keys[i1];
      if (a) drawCover(a, 1);
      if (b && t > 0.001) drawCover(b, t);
    }

    function paintOverlays(p: number) {
      for (const el of scenes) {
        const a = motionOk ? alpha(p, Number(el.dataset.in), Number(el.dataset.out)) : 1;
        const y = (1 - a) * 28;
        const s = 0.975 + a * 0.025;
        el.style.opacity = String(a);
        el.style.transform = `translate3d(0, ${y}px, 0) scale(${s})`;
        el.classList.toggle('is-on', a > 0.08);
        el.setAttribute('aria-hidden', a > 0.08 ? 'false' : 'true');
      }
    }

    function paint(p: number) {
      if (mode === 'keyframes' && ready) paintKeyframes(p);
      else paintProcedural(p);
      paintOverlays(p);
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      paint(smooth);
    }

    function progress() {
      const total = root.offsetHeight - window.innerHeight;
      if (total <= 0) return 0;
      return clamp01(-root.getBoundingClientRect().top / total);
    }

    function tick() {
      target = progress();
      smooth += (target - smooth) * (motionOk ? 0.085 : 1);
      if (Math.abs(target - smooth) < 0.00035) smooth = target;
      paint(smooth);
      requestAnimationFrame(tick);
    }

    async function preloadKeys() {
      if (mode !== 'keyframes') {
        if (loader) {
          loader.hidden = true;
          loader.classList.add('is-done');
        }
        ready = true;
        return;
      }
      if (loader) loader.hidden = false;
      keys = new Array(keyCount).fill(null);
      let done = 0;
      await Promise.all(
        Array.from({ length: keyCount }, (_, i) =>
          new Promise<void>((resolve) => {
            const img = new Image();
            const n = String(i + 1).padStart(keyPad, '0');
            img.src = `${keyPath}${n}.${keyExt}`;
            img.onload = async () => {
              try {
                if (img.decode) await img.decode();
              } catch {
                /* ignore */
              }
              keys[i] = img;
              done += 1;
              if (loaderPct) loaderPct.textContent = `${Math.round((done / keyCount) * 100)}%`;
              resolve();
            };
            img.onerror = () => {
              done += 1;
              if (loaderPct) loaderPct.textContent = `${Math.round((done / keyCount) * 100)}%`;
              resolve();
            };
          })
        )
      );
      ready = keys.filter(Boolean).length >= 2;
      if (!ready) mode = 'procedural';
      loader?.classList.add('is-done');
      if (loader) loader.hidden = true;
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    preloadKeys().then(() => {
      if (!motionOk) {
        paint(0);
        scenes.forEach((el) => {
          el.style.opacity = '1';
          el.style.transform = 'none';
          el.classList.add('is-on');
          el.setAttribute('aria-hidden', 'false');
        });
        return;
      }
      tick();
    });
  }
</script>
