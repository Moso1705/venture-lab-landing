---
/**
 * Michi trajectory chart as a film slide.
 * Fixed aspect-ratio frame + preserveAspectRatio so the SVG never stretches.
 */
import Slide from './Slide.astro';
import { jump } from '../content/site';

const X0 = 120;
const X12 = 820;
const Y_BASE = 320;
const ticks = jump.chart.axis.map((label, i) => ({
  label,
  x: X0 + ((X12 - X0) / (jump.chart.axis.length - 1)) * i,
}));
---

<Slide id="arc">
  <div class="mx-auto max-w-4xl text-center">
    <p class="chart-marker">{jump.marker}</p>
    <h2 id="arc-heading" class="sr-only">{jump.chart.aria}</h2>
    <p class="mt-3 text-base text-white/55 md:text-lg">{jump.sub}</p>
  </div>

  <!-- Desktop / tablet: locked 2.4:1 frame, no stretch -->
  <div
    class="chart-frame mx-auto mt-8 hidden w-full max-w-4xl md:block md:mt-10"
    role="img"
    aria-label={jump.chart.aria}
  >
    <svg
      viewBox="0 0 1000 400"
      width="1000"
      height="400"
      preserveAspectRatio="xMidYMid meet"
      class="chart-svg"
      aria-hidden="true"
    >
      {ticks.map((t) => (
        <line x1={t.x} y1="48" x2={t.x} y2={Y_BASE} stroke="rgba(255,255,255,0.08)" stroke-width="1" />
      ))}
      <line x1="48" y1={Y_BASE} x2="952" y2={Y_BASE} stroke="rgba(255,255,255,0.18)" stroke-width="1" />

      {ticks.map((t) => (
        <g>
          <line x1={t.x} y1={Y_BASE} x2={t.x} y2={Y_BASE + 8} stroke="rgba(255,255,255,0.35)" stroke-width="1" />
          <text
            x={t.x}
            y={Y_BASE + 28}
            text-anchor="middle"
            fill="rgba(255,255,255,0.4)"
            font-family="Inter, sans-serif"
            font-size="11"
            letter-spacing="1.1"
          >
            {t.label}
          </text>
        </g>
      ))}

      <path d="M48 300 L90 300 L108 286 L120 282" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1.5" />
      <text x="50" y="278" fill="rgba(255,255,255,0.45)" font-family="Inter, sans-serif" font-size="11" letter-spacing="1.1">
        {jump.chart.startLabel}
      </text>

      <line
        x1={X0}
        y1="282"
        x2="920"
        y2="278"
        stroke="rgba(255,255,255,0.18)"
        stroke-width="1"
        stroke-dasharray="2 6"
      />
      <text
        x="920"
        y="268"
        text-anchor="end"
        fill="rgba(255,255,255,0.28)"
        font-family="Inter, sans-serif"
        font-size="10"
        letter-spacing="1.1"
      >
        {jump.chart.aloneLabel}
      </text>

      <path
        d="M120 282 C340 280 520 255 640 190 C710 150 780 95 820 58"
        fill="none"
        stroke="#f5f5f3"
        stroke-width="2"
        stroke-linecap="round"
      />

      <circle cx={X0} cy="282" r="4" fill="#f5f5f3" />
      <text x="132" y="304" fill="rgba(255,255,255,0.55)" font-family="Inter, sans-serif" font-size="11" letter-spacing="1.1">
        {jump.chart.labStartLabel}
      </text>

      <circle cx="480" cy="250" r="4" fill="#f5f5f3" />
      <text
        x="480"
        y="232"
        text-anchor="middle"
        fill="rgba(255,255,255,0.55)"
        font-family="Inter, sans-serif"
        font-size="11"
        letter-spacing="1.1"
      >
        {jump.chart.midLabel}
      </text>

      <circle cx={X12} cy="58" r="5" fill="#328efa" />
      <text
        x="808"
        y="48"
        text-anchor="end"
        fill="#328efa"
        font-family="Inter, sans-serif"
        font-size="11"
        font-weight="500"
        letter-spacing="1.1"
      >
        {jump.chart.endLabel}
      </text>

      <line
        x1={X12}
        y1="58"
        x2="910"
        y2="28"
        stroke="#e8400d"
        stroke-width="1.75"
        stroke-dasharray="6 6"
        opacity="0.9"
      />
      <circle cx="910" cy="28" r="4" fill="none" stroke="#e8400d" stroke-width="1.75" opacity="0.9" />
      <text x="922" y="32" fill="#e8400d" font-family="Inter, sans-serif" font-size="11" letter-spacing="1.1" opacity="0.95">
        {jump.chart.branchLabel}
      </text>
    </svg>
  </div>

  <!-- Mobile: separate compact viewBox, same lock -->
  <div
    class="chart-frame chart-frame--mobile mx-auto mt-8 w-full max-w-md md:hidden"
    role="img"
    aria-label={jump.chart.aria}
  >
    <svg
      viewBox="0 0 390 260"
      width="390"
      height="260"
      preserveAspectRatio="xMidYMid meet"
      class="chart-svg"
      aria-hidden="true"
    >
      {[70, 185, 300].map((x) => (
        <line x1={x} y1="28" x2={x} y2="200" stroke="rgba(255,255,255,0.08)" stroke-width="1" />
      ))}
      <line x1="16" y1="200" x2="374" y2="200" stroke="rgba(255,255,255,0.18)" stroke-width="1" />
      {[
        { x: 70, label: 'wk00' },
        { x: 185, label: 'wk06' },
        { x: 300, label: 'wk12' },
      ].map((t) => (
        <g>
          <line x1={t.x} y1="200" x2={t.x} y2="206" stroke="rgba(255,255,255,0.35)" stroke-width="1" />
          <text
            x={t.x}
            y="224"
            text-anchor="middle"
            fill="rgba(255,255,255,0.4)"
            font-family="Inter, sans-serif"
            font-size="10"
            letter-spacing="1"
          >
            {t.label}
          </text>
        </g>
      ))}
      <path d="M16 178 L40 178 L50 170 L70 168" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1.5" />
      <text x="18" y="160" fill="rgba(255,255,255,0.45)" font-family="Inter, sans-serif" font-size="10" letter-spacing="1">
        {jump.chart.startLabel}
      </text>
      <path
        d="M70 168 C150 166 210 145 245 110 C270 85 290 62 300 48"
        fill="none"
        stroke="#f5f5f3"
        stroke-width="2"
        stroke-linecap="round"
      />
      <circle cx="70" cy="168" r="3.5" fill="#f5f5f3" />
      <circle cx="300" cy="48" r="4" fill="#328efa" />
      <text
        x="288"
        y="40"
        text-anchor="end"
        fill="#328efa"
        font-family="Inter, sans-serif"
        font-size="10"
        font-weight="500"
        letter-spacing="1"
      >
        {jump.chart.endLabelShort}
      </text>
      <line x1="300" y1="48" x2="348" y2="24" stroke="#e8400d" stroke-width="1.75" stroke-dasharray="5 5" opacity="0.9" />
      <circle cx="348" cy="24" r="3.5" fill="none" stroke="#e8400d" stroke-width="1.75" opacity="0.9" />
      <text x="340" y="14" text-anchor="end" fill="#e8400d" font-family="Inter, sans-serif" font-size="10" letter-spacing="1" opacity="0.95">
        {jump.chart.branchLabel}
      </text>
    </svg>
  </div>
</Slide>

<style>
  .chart-marker {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-style: italic;
    letter-spacing: -0.02em;
    color: #f5f5f3;
  }

  .chart-frame {
    aspect-ratio: 1000 / 400;
    width: 100%;
    max-width: 56rem;
    margin-inline: auto;
  }

  .chart-frame--mobile {
    aspect-ratio: 390 / 260;
    max-width: 24rem;
  }

  .chart-svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
