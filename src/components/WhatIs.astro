---
/**
 * Offer + path as two full-viewport film slides.
 */
import Slide from './Slide.astro';
import { whatIs } from '../content/site';
---

<span id="top" class="absolute" aria-hidden="true"></span>

<Slide id="program">
  <div class="mx-auto max-w-5xl text-center">
    <p class="slide-marker">{whatIs.pillarsLabel}</p>
    <div class="pillars mt-10" data-stagger>
      {
        whatIs.pillars.map((pillar) => (
          <div class="pillar" data-stagger-item>
            <h2 class="pillar-title">{pillar.title}</h2>
            <p class="pillar-body">{pillar.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 border-t border-white/10 pt-8">
      <p class="slide-marker opacity-70">{whatIs.partners.line}</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-5">
        {
          whatIs.partners.orgs.map((org) => (
            <a
              href={org.href}
              rel="noopener"
              target="_blank"
              class="opacity-60 transition-opacity hover:opacity-100"
              aria-label={org.name}
            >
              <img
                src={org.logo}
                alt=""
                height={org.h}
                style={`height:${org.h}px; filter: brightness(0) invert(1)`}
                class="w-auto"
                loading="lazy"
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Slide>

<Slide id="apply-path" tone="raised">
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 class="font-serif text-[clamp(1.75rem,4.5vw,2.75rem)] leading-none tracking-tight text-hn-blue uppercase">
        {whatIs.pathLabel}
      </h2>
      <p class="slide-marker text-hn-blue">{whatIs.pathEnd}</p>
    </div>

    <ol class="path-rail mt-10 md:mt-12" data-path-rail>
      {
        whatIs.steps.map((step, i) => (
          <li class="path-rail__step" data-path-step style={`--i:${i}`}>
            <p class="path-rail__num" aria-hidden="true">{step.num}</p>
            <h3 class="path-rail__title">{step.title}</h3>
            <p class="path-rail__body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</Slide>

<style>
  .slide-marker {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-style: italic;
    letter-spacing: -0.02em;
    color: #f5f5f3;
  }

  .pillars {
    display: grid;
    gap: 0.85rem;
  }

  .pillar {
    text-align: left;
    padding: 1.15rem 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, #fff 12%, transparent);
    background: color-mix(in srgb, #fff 4%, transparent);
    transition:
      transform 0.35s var(--ease-out-quart),
      border-color 0.35s ease,
      background-color 0.35s ease;
  }

  .pillar-title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #f7f7f5;
  }

  .pillar-body {
    margin-top: 0.45rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: color-mix(in srgb, #f7f7f5 62%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pillar:hover {
      transform: translateY(-4px);
      border-color: color-mix(in srgb, #328efa 45%, transparent);
      background: color-mix(in srgb, #328efa 10%, transparent);
    }
  }

  @media (min-width: 640px) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .pillars {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .path-rail {
    display: grid;
    gap: 0.85rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .path-rail__step {
    padding: 1.15rem 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, #fff 12%, transparent);
    background: color-mix(in srgb, #fff 4%, transparent);
    transition:
      transform 0.35s var(--ease-out-quart),
      border-color 0.35s ease;
  }

  .path-rail__num {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    line-height: 1;
    color: var(--color-hn-blue);
  }

  .path-rail__title {
    margin-top: 0.65rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #f7f7f5;
  }

  .path-rail__body {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: color-mix(in srgb, #f7f7f5 62%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .path-rail__step:hover,
    .path-rail__step.is-active {
      transform: translateY(-4px);
      border-color: color-mix(in srgb, #328efa 45%, transparent);
    }
  }

  @media (min-width: 768px) {
    .path-rail {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
