---
/**
 * Apply band — three direct Google Form CTAs.
 */
import { apply } from '../content/site';

const btnClass = (tone: 'purple' | 'blue' | 'white') =>
  tone === 'purple' ? 'btn-purple' : tone === 'blue' ? 'btn-blue' : 'btn-white';
---

<section id="apply" class="border-b border-line bg-paper">
  <div class="mx-auto max-w-3xl px-6 py-16 md:px-8 md:py-20">
    <div class="reveal text-center">
      <p class="marker">{apply.marker}</p>
      {/* Uppercase CTA headline is intentional (APPLY NOW...), not the serif section-title. */}
      <h2 class="mt-3 text-[clamp(1.5rem,4vw,2.25rem)] font-medium tracking-[0.06em] text-ink uppercase">
        {apply.headline}
      </h2>
      {apply.sub && <p class="section-sub mx-auto max-w-md">{apply.sub}</p>}
    </div>
    <div class="reveal mx-auto mt-8 grid w-full max-w-md gap-3">
      {
        apply.buttons.map((btn) => (
          <a
            href={btn.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[btnClass(btn.tone), 'inline-flex min-h-11 w-full items-center justify-center px-6 text-center']}
          >
            {btn.label}
          </a>
        ))
      }
    </div>
  </div>
</section>
