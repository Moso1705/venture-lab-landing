---
/**
 * Apply band — three direct Google Form CTAs.
 */
import Slide from './Slide.astro';
import { apply } from '../content/site';

const btnClass = (tone: 'purple' | 'blue' | 'white') =>
  tone === 'purple' ? 'btn-purple' : tone === 'blue' ? 'btn-blue' : 'btn-white';
---

<Slide id="apply">
  <div class="mx-auto max-w-xl text-center">
    <p class="slide-marker">{apply.marker}</p>
    <h2 class="mt-3 text-[clamp(1.5rem,4vw,2.25rem)] font-semibold tracking-[0.06em] text-white uppercase">
      {apply.headline}
    </h2>
    {apply.sub && <p class="mt-3 text-base text-white/55">{apply.sub}</p>}
  </div>
  <div class="mx-auto mt-8 grid w-full max-w-md gap-3">
    {
      apply.buttons.map((btn) => (
        <a
          href={btn.href}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[btnClass(btn.tone), 'inline-flex min-h-11 w-full items-center justify-center px-6 text-center']}
        >
          {btn.label}
        </a>
      ))
    }
  </div>
</Slide>

<style>
  .slide-marker {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, #328efa 85%, white);
  }
</style>
