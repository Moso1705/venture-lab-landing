---
/**
 * Full-viewport film slide. Used for every post-hero beat so the page
 * reads as a continuous multi-scene scroll, not a stacked brochure.
 */
interface Props {
  id?: string;
  class?: string;
  tone?: 'void' | 'raised';
}

const { id, class: className, tone = 'void' } = Astro.props;
---

<section
  id={id}
  class:list={['slide', tone === 'raised' && 'slide--raised', className]}
  data-slide
>
  <div class="slide__inner">
    <slot />
  </div>
</section>

<style>
  .slide {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background: #070708;
    color: #f5f5f3;
    overflow: hidden;
  }

  .slide--raised {
    background: #0e0e10;
  }

  .slide::before {
    content: '';
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(50% 45% at 50% 0%, color-mix(in srgb, #328efa 16%, transparent), transparent 70%),
      linear-gradient(to right, color-mix(in srgb, #fff 4%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, #fff 4%, transparent) 1px, transparent 1px);
    background-size: auto, 64px 64px, 64px 64px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 10%, transparent 75%);
    opacity: 0.55;
  }

  .slide__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding: 6.5rem 1.5rem 4rem;
  }

  @media (min-width: 768px) {
    .slide__inner {
      padding: 7rem 2rem 4.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide {
      scroll-snap-align: none;
      scroll-snap-stop: normal;
    }
  }
</style>
