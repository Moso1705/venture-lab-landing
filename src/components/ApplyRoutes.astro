---
/**
 * Pick your path — three role cards linking to Google Forms.
 */
import Slide from './Slide.astro';
import { applyRoutes } from '../content/site';
---

<Slide>
  <div class="mx-auto max-w-2xl text-center">
    <p class="slide-marker">{applyRoutes.marker}</p>
    <h2 class="mt-3 font-serif text-[clamp(2rem,4.5vw,3.25rem)] italic tracking-tight text-white">
      {applyRoutes.headline}
    </h2>
  </div>

  <div class="mt-10 grid gap-4 md:grid-cols-3 md:gap-5" data-stagger>
    {
      applyRoutes.paths.map((path) => (
        <a
          href={path.href}
          target="_blank"
          rel="noopener noreferrer"
          data-stagger-item
          class:list={[
            'path-card group flex flex-col rounded-[var(--radius-md)] p-6 md:p-8',
            path.tone === 'purple' && 'path-card--purple',
            path.tone === 'blue' && 'path-card--blue',
            path.tone === 'white' && 'path-card--white',
          ]}
        >
          <p
            class:list={[
              'text-xs font-medium uppercase tracking-[0.14em]',
              path.tone === 'purple' && 'text-[var(--color-hn-purple)]',
              path.tone === 'blue' && 'text-hn-blue',
              path.tone === 'white' && 'text-white/70',
            ]}
          >
            {path.role}
          </p>
          <h3 class="mt-4 font-serif text-[1.45rem] leading-snug tracking-tight text-white md:text-[1.6rem]">
            {path.title}
          </h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-white/55">{path.body}</p>
          <span
            class:list={[
              'mt-8 inline-flex items-center gap-2 text-sm font-medium',
              path.tone === 'purple' && 'text-[var(--color-hn-purple)]',
              path.tone === 'blue' && 'text-hn-blue',
              path.tone === 'white' && 'text-white',
            ]}
          >
            {path.cta}
            <span class="cta-arrow" aria-hidden="true">→</span>
          </span>
        </a>
      ))
    }
  </div>
</Slide>

<style>
  .slide-marker {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, #328efa 85%, white);
  }

  .path-card {
    border: 1px solid color-mix(in srgb, #fff 12%, transparent);
    background: color-mix(in srgb, #fff 4%, transparent);
    transition:
      transform 0.35s var(--ease-out-quart),
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  .path-card--purple {
    border-color: color-mix(in srgb, #7c5cff 55%, transparent);
    background: color-mix(in srgb, #7c5cff 16%, transparent);
  }

  .path-card--blue {
    border-color: color-mix(in srgb, #328efa 40%, transparent);
    background: color-mix(in srgb, #328efa 12%, transparent);
  }

  .path-card--white {
    border-color: color-mix(in srgb, #fff 28%, transparent);
    background: color-mix(in srgb, #fff 8%, transparent);
  }

  .cta-arrow {
    display: inline-block;
    transition: transform 0.25s var(--ease-out-quart);
  }

  @media (prefers-reduced-motion: no-preference) {
    .path-card:hover {
      transform: translateY(-6px);
    }

    .path-card--purple:hover {
      border-color: color-mix(in srgb, #7c5cff 70%, transparent);
      background: color-mix(in srgb, #7c5cff 22%, transparent);
    }

    .path-card--blue:hover {
      border-color: color-mix(in srgb, #328efa 60%, transparent);
      background: color-mix(in srgb, #328efa 18%, transparent);
    }

    .path-card--white:hover {
      border-color: color-mix(in srgb, #fff 45%, transparent);
      background: color-mix(in srgb, #fff 14%, transparent);
    }

    .path-card:hover .cta-arrow {
      transform: translateX(4px);
    }
  }
</style>
